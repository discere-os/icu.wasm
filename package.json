{
  "name": "@superstruct/icu.wasm",
  "version": "75.1.0",
  "description": "International Components for Unicode (ICU) compiled to WebAssembly",
  "main": "dist/icu.js",
  "module": "dist/icu.js",
  "types": "dist/icu-wasm.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/icu.js",
      "require": "./dist/icu.js",
      "types": "./dist/icu-wasm.d.ts"
    },
    "./core": {
      "import": "./dist/icu-core.js",
      "types": "./dist/icu-wasm.d.ts"
    },
    "./i18n": {
      "import": "./dist/icu-i18n.js", 
      "types": "./dist/icu-wasm.d.ts"
    },
    "./wrapper": {
      "import": "./dist/icu-wasm.js",
      "types": "./dist/icu-wasm.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE"
  ],
  "scripts": {
    "build": "./build-wasm.sh",
    "build:threaded": "./build-wasm-threaded.sh",
    "test": "node test/test-icu-wasm.js",
    "test:basic": "node test/basic-test.mjs",
    "test:performance": "node test/performance-test.js",
    "test:threaded": "node --experimental-wasm-threads test/test-icu-threaded.js",
    "benchmark": "npm run test:performance",
    "benchmark:threaded": "npm run test:threaded",
    "clean": "rm -rf dist/ dist-threaded/ build/ build-threaded/ artifacts/",
    "serve": "python3 -m http.server 8080 --bind 0.0.0.0",
    "serve:headers": "node scripts/serve-with-headers.js",
    "act:test": "act push -j build --matrix config:Release,optimization:ON",
    "act:threaded": "act push -j threaded-build",
    "act:full": "act push",
    "act:performance": "act push -j performance",
    "lint": "echo 'No linting configured for C/C++ project'",
    "typecheck": "tsc --noEmit dist/icu-wasm.d.ts"
  },
  "keywords": [
    "icu",
    "unicode",
    "internationalization",
    "i18n",
    "locale",
    "webassembly", 
    "wasm",
    "collation",
    "formatting",
    "normalization",
    "unicode-processing"
  ],
  "author": "Superstruct Ltd <hello@superstruct.co.nz>",
  "license": "Unicode-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/superstruct/icu.wasm.git",
    "branch": "wasm"
  },
  "bugs": {
    "url": "https://github.com/superstruct/icu.wasm/issues"
  },
  "homepage": "https://github.com/superstruct/icu.wasm#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {},
  "peerDependencies": {},
  "browser": {
    "fs": false,
    "path": false,
    "os": false,
    "crypto": false
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/superstruct"
  },
  "icu": {
    "version": "75.1",
    "modules": {
      "core": {
        "description": "Essential Unicode operations",
        "size": "~8MB",
        "features": ["normalization", "properties", "strings"]
      },
      "i18n": {
        "description": "Internationalization services", 
        "size": "~12MB",
        "features": ["collation", "formatting", "locales"]
      },
      "full": {
        "description": "Complete ICU functionality",
        "size": "~20MB", 
        "features": ["all"]
      },
      "threaded": {
        "description": "Multi-threaded ICU with parallel processing",
        "size": "~25MB", 
        "features": ["all", "threading", "parallel-ops", "bulk-processing"],
        "requirements": ["SharedArrayBuffer", "COOP/COEP headers", "secure-context"]
      }
    },
    "locales": {
      "supported": 200,
      "bundled": ["en", "en-US"],
      "loadable": ["de", "fr", "es", "zh", "ja", "ar", "hi", "ru"]
    },
    "performance": {
      "target_performance": "System-level performance",
      "target": ">90% native performance",
      "memory": {
        "initial": "64MB",
        "maximum": "512MB"
      }
    }
  },
  "wasm": {
    "build": {
      "classification": "Core internationalization services",
      "emscripten": "4.0.13"
    },
    "features": {
      "simd": "future enhancement",
      "threading": "PRODUCTION-READY",
      "filesystem": false,
      "webgpu": "planned",
      "parallel-processing": true,
      "bulk-operations": true
    },
    "builds": {
      "modular": true,
      "targets": ["browser", "node", "worker"],
      "optimization": ["O3", "closure", "lto"],
      "threading": {
        "enabled": true,
        "worker-threads": 4,
        "shared-memory": true,
        "atomic-operations": true
      }
    },
    "performance": {
      "single-threaded": ">90% native performance",
      "multi-threaded": ">95% native performance",
      "parallel-speedup": "2-4x for bulk operations",
      "memory-overhead": "<25% for threading support"
    }
  }
}
